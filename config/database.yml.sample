default: &default
  adapter: postgresql
  encoding: unicode
  pool: <%= ENV.fetch("RAILS_MAX_THREADS", 5) %>
  url: <%= ENV["DATABASE_URL"] %>

development:
  <<: *default
  database: acme_salary_development
  username: <%= ENV.fetch("PGUSER", ENV.fetch("USER", "postgres")) %>

test:
  <<: *default
  database: acme_salary_test
  username: <%= ENV.fetch("PGUSER", ENV.fetch("USER", "postgres")) %>

production:
  <<: *default
  database: acme_salary_production
